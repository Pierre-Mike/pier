{
	"$schema": "https://biomejs.dev/schemas/2.4.7/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"complexity": {
				"useMaxParams": {
					"level": "error",
					"options": {
						"max": 2
					}
				},
				"noExcessiveCognitiveComplexity": {
					"level": "error",
					"options": {
						"maxAllowedComplexity": 15
					}
				},
				"noExcessiveNestedTestSuites": "error",
				"useLiteralKeys": "off"
			},
			"style": {
				"useConst": "error",
				"noParameterAssign": "error"
			},
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedImports": { "level": "error", "fix": "safe" }
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noEmptyBlockStatements": "error",
				"noConsole": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"json": {
		"formatter": {
			"trailingCommas": "none"
		}
	},
	"overrides": [
		{
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
					}
				}
			}
		},
		{
			"includes": ["scripts/**", ".claude/hooks/**", ".claude/hooks.ts"],
			"linter": {
				"rules": {
					"complexity": {
						"noExcessiveCognitiveComplexity": "off"
					},
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		},
		{
			"includes": ["apps/e2e/tests/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		}
	],
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/out",
			"!**/coverage",
			"!**/*.tgz",
			"!**/bun.lock",
			"!**/.astro",
			"!**/.wrangler",
			"!.agentic",
			"!.claude"
		]
	}
}
