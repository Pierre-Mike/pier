---
import ArtifactsPane from "../components/ArtifactsPane.astro";
import LogsModal from "../components/LogsModal.astro";
import PaletteModal from "../components/PaletteModal.astro";
import Sidebar from "../components/Sidebar.astro";
import TerminalPane from "../components/TerminalPane.astro";
import Base from "../layouts/Base.astro";
---

<script is:inline>
	// Pre-paint theme init (spec 044). Reads "pier-theme" from localStorage and
	// applies it to <html> before the body renders so there is no light-flash.
	(function () {
		try {
			var t = localStorage.getItem("pier-theme");
			document.documentElement.dataset.theme = t === "light" ? "light" : "dark";
		} catch (_e) {
			document.documentElement.dataset.theme = "dark";
		}
	})();
</script>

<Base title="pier">
	<Sidebar />
	<TerminalPane />
	<ArtifactsPane />
	<section id="agent-view-root" data-agent-view-root></section>
	<LogsModal />
	<PaletteModal />

	<div id="viewer-modal" class="viewer-modal hidden" role="dialog" aria-modal="true" aria-label="File viewer">
		<div class="viewer-backdrop" data-close></div>
		<div class="viewer-dialog">
			<button class="viewer-close" data-close aria-label="Close">×</button>
			<section id="artifact-viewer" class="empty">
				<div class="placeholder">Click a file to view.</div>
			</section>
		</div>
	</div>

	<button
		type="button"
		data-testid="theme-toggle"
		aria-label="Toggle dark/light theme"
		style="position:fixed;left:14px;bottom:14px;z-index:90;width:36px;height:36px;border-radius:50%;background:var(--bg-elev);color:var(--accent);border:1px solid var(--border);cursor:pointer;font-size:16px;line-height:1;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 14px rgba(0,0,0,0.4);"
	>◐</button>

	<div id="toast"></div>
</Base>

<script>
	import { store } from "../dashboard/state";
	import { api } from "../api";
	import {
		refreshProjects,
		renderProjects,
		renderSessions,
		renderTerminal,
		wireProjectsUI,
		selectProject,
	} from "../dashboard/projects";
	import { wirePaneToggle, wireResizeHandle, wireTerminalRefit } from "../dashboard/ui";
	import { loadConfig, renderFileTree, wireFileTreeUI } from "../dashboard/files";
	import { renderRefs } from "../dashboard/refs";
	import { wireViewerModal } from "../dashboard/viewer";
	import { wireTerminalDrop } from "../dashboard/drop";
	import { wireLogsModal, renderLogs, renderLogsCards, pushLog } from "../dashboard/logs";
	import { wireSettingsModal } from "../dashboard/settings";
	import { subscribeEvents } from "../dashboard/sse";
	import type { ClaudeEvent } from "../dashboard/types";
	import { wireDefaultSession } from "../dashboard/default-session";
	import { installPalette } from "../dashboard/palette";
	import { openRepoFile } from "../dashboard/viewer";
	import { initTheme } from "../dashboard/theme";
	import { mountAgentView } from "../dashboard/agent-view";

	async function init() {
		initTheme();
		await loadConfig();
		await refreshProjects();
		subscribeEvents(handleEvent);
		wireObservers();
		wireUI();
		const agentViewRoot = document.getElementById("agent-view-root");
		if (agentViewRoot) {
			mountAgentView(agentViewRoot);
		}
		const last = localStorage.getItem("pier:active-project");
		if (last && store.projects.some((p) => p.id === last)) {
			void selectProject(last);
		}
	}

	function handleEvent(evt: unknown): void {
		const e = evt as ClaudeEvent;
		if (!e) return;
		if (e.project && e.project !== store.activeProject) {
			store.projectsWithEvents.add(e.project);
		}
		pushLog(e);
	}

	function wireObservers() {
		store.observe(() => renderProjects());
		store.observe(() => renderSessions());
		store.observe(() => renderTerminal());
		store.observe(() => renderFileTree());
		store.observe(() => renderRefs());
		store.observe(() => {
			if (store.logsOpen) renderLogs();
		});
		store.observe(() => renderLogsCards());
	}

	function wireUI() {
		wireProjectsUI();
		wireDefaultSession();
		wireFileTreeUI();
		wireTerminalRefit();
		wireTerminalDrop();
		wireViewerModal();
		wireLogsModal();
		wireSettingsModal();
		wirePaletteUI();
		wirePaneToggle("collapse-sidebar", "sidebar", "collapsed-left", "❮", "❯");
		wirePaneToggle("collapse-artifacts", "artifacts", "collapsed-right", "❯", "❮");
		wireResizeHandle();
	}

	// biome-ignore lint/complexity/noExcessiveCognitiveComplexity: palette UI wiring
	function wirePaletteUI() {
		const modalEl = document.getElementById("palette-modal");
		const inputEl = document.getElementById("palette-input");
		const listEl = document.getElementById("palette-list");
		const backdropEl = document.getElementById("palette-backdrop");
		if (!modalEl || !inputEl || !listEl || !backdropEl) return;

		// Rebind as concrete types after null guard — TypeScript narrows let-bindings
		// inside closures to their widened type, so we use local const aliases.
		const paletteModal: HTMLElement = modalEl;
		const paletteInput: HTMLInputElement = inputEl as HTMLInputElement;
		const paletteList: HTMLElement = listEl;

		const handle = installPalette({
			selectProject,
			openViewer: (_pid: string, path: string) => {
				void openRepoFile(path, path.split("/").at(-1) ?? path);
			},
			getStore: () => ({
				projects: store.projects,
				activeProject: store.activeProject,
			}),
			fetchFileResults: async (query: string, signal: AbortSignal) => {
				if (!store.activeProject) return [];
				// biome-ignore lint/suspicious/noExplicitAny: Hono RPC client resolves fine at runtime; TS needs help in Astro client scripts
				const res = await (api as any).api.projects[":id"].files.search.$get(
					{ param: { id: store.activeProject }, query: { q: query, limit: "50" } },
					{ init: { signal } },
				);
				if (!res.ok) return [];
				const data = (await res.json()) as { files: Array<{ path: string }> };
				return data.files.map((f) => ({
					kind: "file" as const,
					label: f.path,
					_id: f.path,
					_path: f.path,
				}));
			},
		});

		let highlighted = 0;

		function setHighlight(rows: NodeListOf<HTMLElement>, idx: number) {
			highlighted = idx;
			rows.forEach((r, i) => r.setAttribute("aria-selected", i === idx ? "true" : "false"));
			rows[idx]?.scrollIntoView({ block: "nearest" });
		}

		function renderList(query: string) {
			const entries = handle.getEntries(query);
			paletteList.innerHTML = "";
			highlighted = 0;
			entries.forEach((entry, idx) => {
				const li = document.createElement("li");
				li.className = `palette-row ${entry.kind}`;
				li.setAttribute("role", "option");
				li.setAttribute("aria-selected", idx === highlighted ? "true" : "false");
				li.dataset.index = String(idx);

				const glyph = document.createElement("span");
				glyph.className = "palette-row-glyph";
				glyph.textContent = "●";

				const labelEl = document.createElement("span");
				labelEl.className = "palette-row-label";
				if (entry.kind === "file") {
					const lastSlash = entry.label.lastIndexOf("/");
					const dirText = lastSlash >= 0 ? entry.label.slice(0, lastSlash) : "";
					const baseText = lastSlash >= 0 ? entry.label.slice(lastSlash + 1) : entry.label;
					const nameSpan = document.createElement("span");
					nameSpan.className = "palette-row-name";
					nameSpan.textContent = baseText;
					labelEl.appendChild(nameSpan);
					if (dirText) {
						const dirSpan = document.createElement("span");
						dirSpan.className = "palette-row-dir";
						dirSpan.textContent = dirText;
						labelEl.appendChild(dirSpan);
					}
				} else {
					const nameSpan = document.createElement("span");
					nameSpan.className = "palette-row-name";
					nameSpan.textContent = entry.label;
					labelEl.appendChild(nameSpan);
				}

				const caption = document.createElement("span");
				caption.className = "palette-row-caption";
				caption.textContent = entry.kind;

				li.appendChild(glyph);
				li.appendChild(labelEl);
				li.appendChild(caption);
				li.addEventListener("click", () => {
					handle.selectRowAt(idx);
					syncModal();
				});
				paletteList.appendChild(li);
			});
		}

		function syncModal() {
			if (handle.isOpen()) {
				paletteModal.classList.remove("hidden");
				paletteInput.value = "";
				renderList("");
				paletteInput.focus();
			} else {
				paletteModal.classList.add("hidden");
				paletteInput.value = "";
				paletteList.innerHTML = "";
			}
		}

		// Keydown on document (capture phase) — handles the Shift,Shift gesture,
		// and when the palette is open also owns arrow-key nav + Enter so the
		// keys work regardless of which child element currently has focus.
		document.addEventListener(
			"keydown",
			(e: KeyboardEvent) => {
				if (handle.isOpen()) {
					const rows = paletteList.querySelectorAll<HTMLElement>(".palette-row");
					if (e.key === "ArrowDown") {
						e.preventDefault();
						setHighlight(rows, Math.min(highlighted + 1, rows.length - 1));
						return;
					}
					if (e.key === "ArrowUp") {
						e.preventDefault();
						setHighlight(rows, Math.max(highlighted - 1, 0));
						return;
					}
					if (e.key === "Enter") {
						e.preventDefault();
						handle.selectRowAt(highlighted);
						syncModal();
						return;
					}
					if (e.key === "Escape") {
						handle.esc();
						syncModal();
						return;
					}
				}
				if (e.key === "Shift") {
					handle.tap(Date.now(), {
						ctrlKey: e.ctrlKey,
						metaKey: e.metaKey,
						altKey: e.altKey,
					});
					syncModal();
				} else {
					handle.nonShiftKey();
				}
			},
			true,
		);

		// Relay from cross-origin terminal iframe — installPalette already listens
		// on globalThis for the message and updates open-state. This sibling
		// listener exists solely to repaint the modal after a relayed tap.
		window.addEventListener("message", (e: MessageEvent) => {
			const data = e.data as { type?: string } | null;
			if (data && data.type === "palette-shift-tap") syncModal();
		});

		paletteInput.addEventListener("input", () => {
			renderList(paletteInput.value);
		});

		// Close on backdrop click
		backdropEl.addEventListener("click", () => {
			handle.esc();
			syncModal();
		});
	}

	init().catch((e) => {
		console.error("Dashboard init failed:", e);
	});
</script>
