---
import ArtifactsPane from "../components/ArtifactsPane.astro";
import Sidebar from "../components/Sidebar.astro";
import TerminalPane from "../components/TerminalPane.astro";
import Base from "../layouts/Base.astro";
---

<Base title="piguy-web">
	<Sidebar />
	<TerminalPane />
	<ArtifactsPane />

	<div id="viewer-modal" class="viewer-modal hidden" role="dialog" aria-modal="true" aria-label="File viewer">
		<div class="viewer-backdrop" data-close></div>
		<div class="viewer-dialog">
			<button class="viewer-close" data-close aria-label="Close">×</button>
			<section id="artifact-viewer" class="empty">
				<div class="placeholder">Click a file to view.</div>
			</section>
		</div>
	</div>

	<div id="toast"></div>
</Base>

<script>
	import { store } from "../dashboard/state";
	import {
		refreshProjects,
		renderProjects,
		renderSessions,
		renderTerminal,
		wireProjectsUI,
		selectProject,
	} from "../dashboard/projects";
	import { wirePaneToggle, wireResizeHandle, wireTerminalRefit } from "../dashboard/ui";
	import { loadConfig, renderFileTree, wireFileTreeUI } from "../dashboard/files";
	import { wireViewerModal } from "../dashboard/viewer";
	import { wireTerminalDrop } from "../dashboard/drop";

	async function init() {
		await loadConfig();
		await refreshProjects();
		wireObservers();
		wireUI();
		const last = localStorage.getItem("piguy:active-project");
		if (last && store.projects.some((p) => p.id === last)) {
			void selectProject(last);
		}
	}

	function wireObservers() {
		store.observe(() => renderProjects());
		store.observe(() => renderSessions());
		store.observe(() => renderTerminal());
		store.observe(() => renderFileTree());
	}

	function wireUI() {
		wireProjectsUI();
		wireFileTreeUI();
		wireTerminalRefit();
		wireTerminalDrop();
		wireViewerModal();
		wirePaneToggle("collapse-sidebar", "sidebar", "collapsed-left", "❮", "❯");
		wirePaneToggle("collapse-artifacts", "artifacts", "collapsed-right", "❯", "❮");
		wireResizeHandle();
	}

	init().catch((e) => {
		console.error("Dashboard init failed:", e);
	});
</script>
