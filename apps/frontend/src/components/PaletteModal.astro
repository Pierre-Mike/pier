---
/**
 * Command palette overlay — spec 010.
 * Triggered by a double-shift gesture (see palette.ts + index.astro).
 * Mirrors the LogsModal / viewer-modal overlay structure.
 */
---

<div id="palette-modal" class="palette-overlay hidden" role="dialog" aria-modal="true" aria-label="Command palette">
	<div class="palette-backdrop" id="palette-backdrop"></div>
	<div class="palette-dialog">
		<input
			id="palette-input"
			class="palette-input"
			type="search"
			placeholder="Jump to project or file…"
			autocomplete="off"
			spellcheck="false"
		/>
		<ul id="palette-list" class="palette-list" role="listbox" aria-label="Results"></ul>
	</div>
</div>

<style>
	.palette-overlay {
		position: fixed;
		inset: 0;
		z-index: 9000;
		display: flex;
		align-items: flex-start;
		justify-content: center;
		padding-top: 12vh;
	}

	.palette-overlay.hidden {
		display: none;
	}

	.palette-backdrop {
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.6);
		backdrop-filter: blur(2px);
	}

	.palette-dialog {
		position: relative;
		z-index: 1;
		width: min(640px, 90vw);
		max-height: 70vh;
		background: var(--bg-elev);
		border: 1px solid var(--border);
		border-radius: 6px;
		box-shadow: 0 16px 48px rgba(0, 0, 0, 0.55);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		font-family: inherit;
	}

	.palette-input {
		width: 100%;
		box-sizing: border-box;
		padding: 12px 14px;
		font: inherit;
		font-size: 0.95rem;
		background: var(--bg);
		border: none;
		border-bottom: 1px solid var(--border);
		color: var(--fg);
		outline: none;
	}

	.palette-input::placeholder {
		color: var(--fg-dim);
	}

	.palette-input:focus {
		border-bottom-color: var(--accent-dim);
	}

	.palette-list {
		list-style: none;
		margin: 0;
		padding: 4px 0;
		overflow-y: auto;
		overflow-x: hidden;
	}

	.palette-list:empty::after {
		content: "no matches";
		display: block;
		padding: 12px 14px;
		color: var(--fg-dim);
		font-size: 0.85rem;
	}

	.palette-row {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 7px 14px;
		cursor: pointer;
		color: var(--fg);
		font-size: 0.9rem;
		border-left: 2px solid transparent;
		user-select: none;
	}

	.palette-row:hover {
		background: var(--bg-hover);
	}

	.palette-row[aria-selected="true"] {
		background: var(--bg-hover);
		border-left-color: var(--accent);
	}

	.palette-row-kind {
		font-size: 0.65rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: 2px 6px;
		border-radius: 3px;
		flex-shrink: 0;
		min-width: 38px;
		text-align: center;
		border: 1px solid var(--border);
		color: var(--fg-dim);
		background: var(--bg);
	}

	.palette-row-kind.project {
		color: var(--accent);
		border-color: var(--accent-dim);
	}

	.palette-row-label {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		flex: 1;
	}
</style>
