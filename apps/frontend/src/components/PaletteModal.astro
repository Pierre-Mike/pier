---
/**
 * Command palette overlay — spec 010.
 * Triggered by a double-shift gesture (see palette.ts + index.astro).
 * Styles live in src/styles/dashboard.css (global) so they reach the
 * runtime-created .palette-row children, which would otherwise miss the
 * Astro-scoped hash class.
 */
---

<div id="palette-modal" class="palette-overlay hidden" role="dialog" aria-modal="true" aria-label="Command palette">
	<div class="palette-backdrop" id="palette-backdrop"></div>
	<div class="palette-dialog">
		<input
			id="palette-input"
			class="palette-input"
			type="search"
			placeholder="Jump to project or file…"
			autocomplete="off"
			spellcheck="false"
		/>
		<ul id="palette-list" class="palette-list" role="listbox" aria-label="Results"></ul>
	</div>
</div>
