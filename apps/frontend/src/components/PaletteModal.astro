---
/**
 * Command palette overlay — spec 010.
 * Triggered by a double-shift gesture (see palette.ts + index.astro).
 * Mirrors the LogsModal / viewer-modal overlay structure.
 */
---

<div id="palette-modal" class="palette-overlay hidden" role="dialog" aria-modal="true" aria-label="Command palette">
	<div class="palette-backdrop" id="palette-backdrop"></div>
	<div class="palette-dialog">
		<input
			id="palette-input"
			class="palette-input"
			type="search"
			placeholder="Jump to project or file…"
			autocomplete="off"
			spellcheck="false"
		/>
		<ul id="palette-list" class="palette-list" role="listbox" aria-label="Results"></ul>
	</div>
</div>

<style>
	.palette-overlay {
		position: fixed;
		inset: 0;
		z-index: 9000;
		display: flex;
		align-items: flex-start;
		justify-content: center;
		padding-top: 10vh;
	}

	.palette-overlay.hidden {
		display: none;
	}

	.palette-backdrop {
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.55);
		backdrop-filter: blur(3px);
	}

	.palette-dialog {
		position: relative;
		z-index: 1;
		width: min(720px, 92vw);
		max-height: 72vh;
		background: var(--bg-elev);
		border: 1px solid var(--border);
		border-radius: 8px;
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.65);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		font-family: inherit;
	}

	.palette-input {
		width: 100%;
		box-sizing: border-box;
		padding: 16px 20px;
		font: inherit;
		font-size: 1.05rem;
		background: var(--bg);
		border: none;
		border-bottom: 1px solid var(--border);
		color: var(--fg);
		outline: none;
	}

	.palette-input::placeholder {
		color: var(--fg-dim);
	}

	.palette-input:focus {
		border-bottom-color: var(--accent-dim);
	}

	.palette-list {
		list-style: none;
		margin: 0;
		padding: 8px 0;
		overflow-y: auto;
		overflow-x: hidden;
	}

	.palette-list:empty::after {
		content: "no matches";
		display: block;
		padding: 16px 20px;
		color: var(--fg-dim);
		font-size: 0.9rem;
	}

	.palette-row {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 10px 20px;
		cursor: pointer;
		color: var(--fg);
		font-size: 0.95rem;
		border-left: 2px solid transparent;
		user-select: none;
	}

	.palette-row + .palette-row {
		margin-top: 2px;
	}

	.palette-row:hover {
		background: var(--bg-hover);
	}

	.palette-row[aria-selected="true"] {
		background: var(--bg-hover);
		border-left-color: var(--accent);
	}

	.palette-row-glyph {
		flex-shrink: 0;
		width: 14px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 0.55rem;
	}

	.palette-row.project .palette-row-glyph {
		color: var(--accent);
	}

	.palette-row.file .palette-row-glyph {
		color: var(--ok);
	}

	.palette-row.project .palette-row-caption {
		color: var(--accent-dim);
	}

	.palette-row.file .palette-row-caption {
		color: var(--ok);
		opacity: 0.65;
	}

	.palette-row-label {
		flex: 1;
		min-width: 0;
		display: flex;
		align-items: baseline;
		gap: 8px;
		overflow: hidden;
	}

	.palette-row-name {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.palette-row-dir {
		color: var(--fg-dim);
		font-size: 0.85rem;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		direction: rtl;
		text-align: left;
		flex-shrink: 1;
		min-width: 0;
	}

	.palette-row-caption {
		flex-shrink: 0;
		font-size: 0.75rem;
		color: var(--fg-dim);
		letter-spacing: 0.04em;
	}
</style>
