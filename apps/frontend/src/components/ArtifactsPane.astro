---
// Artifacts pane - file tree browser
---

<aside id="artifacts">
	<div class="resize-handle" id="resize-right" aria-label="Resize files pane" title="Drag to resize"></div>
	<header class="pane-head">
		<button class="collapse" id="collapse-artifacts" title="Collapse files" aria-label="Collapse files">❯</button>
		<h2 id="files-title">Files</h2>
		<a id="open-vscode-folder" class="open-vscode" href="#" title="Open project folder in VS Code Insiders" hidden>VSCode ↗</a>
		<input id="file-filter" type="search" placeholder="filter…" />
		<button id="files-refresh" title="Refresh file list" aria-label="Refresh file list">↻</button>
	</header>
	<div id="file-tree" class="file-tree">
		<div class="placeholder">Select a project to browse files.</div>
	</div>
	<div id="refs-list" class="refs-list" hidden></div>
</aside>
