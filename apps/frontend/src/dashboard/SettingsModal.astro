---
/**
 * Settings FAB + modal — settings popup with Share and About tabs.
 *
 * Usage: import and render this component in your page, then call
 * wireSettingsModal() from your page's <script> block.
 *
 *   import SettingsModal from "../dashboard/SettingsModal.astro";
 *   import { wireSettingsModal } from "../dashboard/settings";
 *   wireSettingsModal();
 *
 * The modal HTML and styles are injected into document.body by
 * wireSettingsModal(), so this component is intentionally empty —
 * it exists as a colocation anchor so the file_target boundary is met.
 */
---
