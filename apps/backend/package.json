{
	"name": "@piguy/backend",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		"./types": "./src/backend/shell/api.ts"
	},
	"scripts": {
		"dev": "bun run --watch src/backend/main.ts",
