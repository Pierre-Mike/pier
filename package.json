{
	"name": "pier",
	"private": true,
	"packageManager": "bun@1.3.6",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"test": "turbo test",
		"typecheck": "turbo typecheck",
		"lint": "biome check --write .",
		"lint:file": "biome check --write",
		"lint:ci": "biome ci .",
		"colocated-tests": "bash scripts/colocated-tests.sh",
		"secret-scan": "gitleaks detect --no-banner",
		"check": "bun run typecheck && bun run lint && bun run test && bun run spec:lint",
		"spec:lint": "bun scripts/spec-lint.ts",
		"spec:status": "bun scripts/spec-status.ts",
		"spec:complete": "bun scripts/spec-complete.ts",
		"tasks:verify": "bun scripts/tasks-verify.ts",
		"preflight": "bun scripts/preflight-main-ci.ts",
		"worktree:open": "bun scripts/worktree-open.ts",
		"worktree:close": "bun scripts/worktree-close.ts",
		"sync": "bun scripts/worktree-close.ts",
		"e2e": "cd apps/e2e && bun run e2e",
		"e2e:fresh": "cd apps/e2e && E2E_FRESH=1 bun run e2e",
		"e2e:install": "cd apps/e2e && bun run e2e:install",
		"prepare": "bunx lefthook install --force"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.7",
		"@types/bun": "latest",
		"gray-matter": "^4.0.3",
		"happy-dom": "^20.9.0",
		"lefthook": "^2.1.4",
		"turbo": "^2.7.0",
		"typescript": "^5"
	}
}
